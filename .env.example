# Copy this file to .env.local and fill in the values you have.
# Both are optional — features relying on them are silently skipped when unset.

# Powers the per-project coding-time badges (Settings -> API Key on wakatime.com).
WAKATIME_API_KEY=

# Powers the project detail page's release version and CI status. Fine-grained
# PAT with repo read access.
GITHUB_TOKEN=

# Powers the contact form's email delivery (resend.com -> API Keys). Required
# for the form to actually send; the route handler fails gracefully with an
# error toast when unset.
RESEND_API_KEY=
