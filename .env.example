# Copy this file to .env.local and fill in the values you have.
# Both are optional — features relying on them are silently skipped when unset.

# Powers the per-project coding-time badges (Settings -> API Key on wakatime.com).
WAKATIME_API_KEY=

# Powers the project detail page's release version, CI status, and language
# breakdown chart. Fine-grained PAT with repo read access.
GITHUB_TOKEN=
